# Local: copy to .env, run npm run dev. Never commit .env or actual secrets.
# Hostinger: add values through hPanel environment settings.
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
PORT=3000
# Production requires MySQL. Empty DB_NAME permits filesystem storage ONLY in development.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DATA_DIR=./data
# Reserved organizer email; admin role is granted only through a server-side setup command.
ADMIN_EMAIL=
# Temporary, used by npm run create-admin / npm run recover-admin. Remove after use.
ADMIN_SETUP_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
